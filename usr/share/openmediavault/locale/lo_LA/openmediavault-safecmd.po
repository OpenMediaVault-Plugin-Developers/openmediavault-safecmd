msgid "Allowlist"
msgstr "ລາຍຊື່ທີ່ອະນຸຍາດ"

msgid "Command"
msgstr "ຄຳສັ່ງ"

msgid "Command has been run."
msgstr "ດຳເນີນການຄຳສັ່ງສຳເລັດແລ້ວ."

msgid "Create"
msgstr "ສ້າງ"

msgid "Created command."
msgstr "ສ້າງຄຳສັ່ງສຳເລັດແລ້ວ."

msgid "Delete"
msgstr "ລຶບ"

msgid "Denylist"
msgstr "ລາຍຊື່ທີ່ປະຕິເສດ"

msgid "Description"
msgstr "ຄຳອະທິບາຍ"

msgid "Docs"
msgstr "ເອກະສານ"

msgid "Edit"
msgstr "ແກ້ໄຂ"

msgid "Edit command."
msgstr "ແກ້ໄຂຄຳສັ່ງ."

msgid "Execute command"
msgstr "ປະຕິບັດຄຳສັ່ງ"

msgid ""
"List of usernames allowed to run command.<br/>Leave blank to allow all users"
" not in deny list to run command."
msgstr ""
"ລາຍຊື່ຜູ້ໃຊ້ທີ່ໄດ້ຮັບອະນຸຍາດໃຫ້ລັນຄຳສັ່ງ.<br/>ປະຫວ່າງໄວ້ເພື່ອອະນຸຍາດໃຫ້ຜູ້ໃຊ້ທັງໝົດທີ່ບໍ່ຢູ່ໃນລາຍຊື່ປະຕິເສດສາມາດລັນຄຳສັ່ງໄດ້."

msgid "List of usernames not allowed to run command."
msgstr "ລາຍຊື່ຜູ້ໃຊ້ທີ່ບໍ່ໄດ້ຮັບອະນຸຍາດໃຫ້ລັນຄຳສັ່ງ."

msgid "Log"
msgstr "ບັນທຶກເຫດການ"

msgid "Log output of command of user runs."
msgstr "ບັນທຶກຜົນການລັນຄຳສັ່ງຂອງຜູ້ໃຊ້."

msgid "Name"
msgstr "ຊື່"

msgid "Run command ..."
msgstr "ລັນຄຳສັ່ງ ..."

msgid "Running command ..."
msgstr "ກຳລັງລັນຄຳສັ່ງ ..."

msgid "SafeCmd"
msgstr "SafeCmd"

msgid "omv-extras.org wiki"
msgstr "omv-extras.org wiki"
